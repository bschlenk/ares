{
  "name": "ares",
  "version": "0.1.0",
  "private": true,
  "description": "ares native emulator frontend",
  "main": "dist/main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node scripts/test.js",
    "fixture": "node fixture.cjs artifacts/spike.gb",
    "smoke": "node smoke.cjs",
    "build:services": "node scripts/build.js",
    "test:session": "node scripts/build.js && node --test tests/session-live.test.cjs",
    "presmoke": "node scripts/build.js",
    "test:local-ai": "node scripts/build.js && electron tests/electron-local-ai.js",
    "test:electron": "node scripts/build.js && electron tests/electron-session.js",
    "package:mac": "node scripts/build.js && node scripts/package-macos.js",
    "test:mcp": "node scripts/build.js && electron tests/electron-mcp.js",
    "test:package": "node tests/package-live.cjs",
    "build": "node scripts/build.js",
    "clean": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist',{recursive:true,force:true})\"",
    "test:state-reference": "node scripts/build.js && node tests/state-reference.cjs",
    "test:journal": "node scripts/build.js && node --test tests/plugin-journal.test.js && electron tests/electron-journal.js",
    "test:plugins": "node scripts/build.js && electron tests/electron-plugins.js",
    "test:reload": "node scripts/build.js && electron tests/electron-reload.js",
    "test:plugin-tools": "node scripts/build.js && electron tests/electron-plugin-tools.js",
    "test:kirby": "node scripts/build.js && electron tests/electron-kirby.js",
    "test:kirby-feedback": "node scripts/build.js && node tests/kirby-feedback-live.cjs",
    "plugin": "node dist/plugins/cli.js",
    "test:profiles": "node scripts/build.js && node tests/profile-live.cjs",
    "test:launch": "node tests/launch-live.cjs",
    "test:plugin-settings": "node scripts/build.js && electron tests/electron-plugin-settings.js",
    "test:workspace": "node scripts/build.js && electron tests/electron-workspace.js",
    "test:library": "node scripts/build.js && electron tests/electron-library.js",
    "test:keyboard": "node scripts/build.js && electron tests/electron-keyboard.js",
    "test:playback": "node scripts/build.js && electron tests/electron-playback.js",
    "test:dev": "node scripts/build.js && node tests/dev-runtime-live.js",
    "test:settings": "node scripts/build.js && electron tests/electron-settings.js",
    "test:recovery": "node scripts/build.js && electron tests/electron-recovery.js --disable-plugins",
    "accept": "node scripts/accept.js",
    "test:agent": "node scripts/build.js && electron tests/electron-agent-integration.js",
    "test:automatic-launch": "node scripts/build.js && node tests/automatic-launch.cjs",
    "test:demonstration": "node scripts/build.js && electron tests/electron-demonstration.js",
    "test:controls": "node scripts/build.js && electron tests/electron-controls.js",
    "test:all": "node scripts/test-all.js",
    "test:matrix": "node scripts/build.js && node tests/kirby-matrix-live.cjs",
    "test:skeleton": "node scripts/build.js && electron tests/electron-kirby-skeleton.js",
    "test:feedback-cost": "node scripts/build.js && node tests/kirby-feedback-cost.cjs",
    "test:playback-controls": "node scripts/build.js && node --test tests/focus-pause.test.js && electron tests/electron-playback-controls.js",
    "test:save-states": "node scripts/build.js && node --test tests/checkpoint-library.test.js tests/checkpoint-native.test.js && electron tests/electron-checkpoints.js",
    "test:save-states-private": "node scripts/build.js && node tests/checkpoint-private.js",
    "test:save-states-cross-core": "node scripts/build.js && node tests/checkpoint-cross-core.js",
    "test:paired-recovery": "node scripts/build.js && node --test --test-concurrency=1 tests/paired-recovery.test.js tests/paired-recovery-native.test.js tests/paired-recovery-electron.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "45.1.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "esbuild": "0.28.2",
    "zod": "^4.6.7"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
